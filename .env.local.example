# Copy this file to .env.local and fill in your values before running the project
# cp .env.local.example .env.local

# Email credentials for the contact form API (Module 4)
# Use a Gmail App Password — NOT your main account password
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password_here

# Public site URL — change to your production domain before deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000
